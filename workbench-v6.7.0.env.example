# Sustainable Catalyst Workbench v6.7.0 — Platform Core Connectivity Foundation
# Copy relevant values into the deployment environment. Never commit real secrets.

SCWB_ALLOWED_ORIGINS=https://sustainablecatalyst.com,https://www.sustainablecatalyst.com

# Outbound Core identity/configuration. v6.7.0 records configuration only and does
# not automatically dispatch work to Platform Core.
SCWB_CORE_URL=
SCWB_CORE_API_KEY=
SCWB_CORE_ENABLED=false
SCWB_CORE_REQUIRED=false
SCWB_CORE_EXPECTED_VERSION_PREFIX=3.

# Shared token for the new /integration/core/* routes.
# If required=true, set the SAME secret in Platform Core's Workbench service
# registry configuration as SC_CORE_WORKBENCH_SERVICE_TOKEN.
SCWB_SERVICE_TOKEN=
SCWB_REQUIRE_SERVICE_TOKEN=false
